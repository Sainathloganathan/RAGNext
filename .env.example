# ==============================================================================
# RAGNext (Cyber Knights — SH-SVA-04) Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Options: 'postgres' | 'sqlite' (default for zero-friction local development)
DB_TYPE=sqlite
DB_FILE=./storage/data/ragnext.sqlite

# PostgreSQL Configuration (used when DB_TYPE=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ragnext_db
PG_USER=postgres
PG_PASSWORD=postgres

# Local AI & Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector Storage Configuration
# Options: 'chroma' | 'embedded' (persistent local vector storage in storage/vectors)
VECTOR_STORE_TYPE=embedded
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=ragnext_documents

# Document Processing & Chunker Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=25
STORAGE_DIR=./storage/uploads
